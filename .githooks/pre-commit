#!/bin/sh
# =====================================================================
#  pre-commit — run the offline checkers before a commit touching demos/ or api/
#
#  molecule-pipeline.md item 8. Every checker in this repo was hand-run, and
#  SCIENCE.md §1.4's rule — a chemical claim ships with its assertion in the
#  same commit — was enforced by nothing but attention. That was survivable at
#  one molecule per page. It is not survivable at ~34 more added by an agent
#  that has no memory of the last session.
#
#  Installed by `npm i` in demos/ (the `prepare` script points core.hooksPath
#  here). To disable:  git config --unset core.hooksPath
#
#  WHAT IT DOES NOT DO, deliberately:
#   · does not run tools/check-handedness.js — that needs the network and a dev
#     dependency, and a network call in a commit path is a liability. It is the
#     only check that catches a global mirror, so run it BY HAND after touching
#     a ring builder (see SCIENCE.md §1.3).
#   · does not run check-docs.js — it ran on every demos/ commit, but the docs
#     are simple enough right now that running it constantly isn't worth it.
#     Run it BY HAND (node tools/check-docs.js) after editing an enumeration.
#   · does not run check-molecules.js unless the commit touches a file that can
#     change a spec's geometry (lib/molecules.js, lib/skel.js, a lib/mol-*.js
#     domain file, a committed tools/sdf/ input, or a BAKER whose output lives
#     in a spec:
#     tools/bake-flat2d.js and tools/spec2smiles.js both write fields that
#     check-molecules.js re-derives and fails on when stale, and neither lives
#     anywhere the patterns above would catch. A commit that only edits prose,
#     an .html page, or fx.js cannot make a claim check-molecules.js audits.
#   · does not run check-pages.js unless the commit touches a *.html page, a
#     file that supplies the registry it reads (lib/molecules.js, lib/skel.js, a
#     lib/mol-*.js domain file, lib/lib-node.js), or the pair its third audit
#     reads: the root index.html and vercel.json. A prose-only or scene.js commit
#     cannot change which molecule a page loads or names.
#   · does not check staged content in isolation. It runs against the working
#     tree, so a partially-staged commit is checked as what is on disk, not as
#     what is being committed. That is the honest 95% answer; the alternative is
#     a temp checkout on every commit.
#   · does not stop you. `git commit --no-verify` skips it. The goal is that
#     nobody FORGETS, not that nobody can decide.
# =====================================================================
set -e

# Only care about commits that touch the molecule sandbox, the tutor, or the
# front door. api/ is in here because the ask endpoint lives at the repo root so
# Vercel will serve it, and a gate that only looked at demos/ skipped the whole
# tutor without saying so. index.html and vercel.json are here for the same
# reason one level out: the front page and the route table that resolves its
# links are both outside demos/, and a commit touching only those two would exit
# here and never reach the check-pages gate below.
if git diff --cached --name-only | grep -qE '^(demos/|api/|index\.html$|vercel\.json$)'; then
  :
else
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT/demos"

echo "pre-commit: checking demos/ ..."

if git diff --cached --name-only | grep -qE '^demos/(lib/(molecules|skel|mol-[^/]+)\.js|tools/sdf/|tools/(bake-flat2d|spec2smiles)\.js)'; then
  if ! node check-molecules.js > /tmp/cm.$$ 2>&1; then
    tail -25 /tmp/cm.$$; rm -f /tmp/cm.$$
    echo ""
    echo "pre-commit FAILED: check-molecules.js"
    echo "  Fix it, or commit with --no-verify if you know why it is wrong."
    exit 1
  fi
  rm -f /tmp/cm.$$
else
  echo "pre-commit: skipping check-molecules.js — no spec file staged"
fi

# The root index.html and vercel.json are in the gate because audit 3 reads them:
# the front page's links are short URLs, which vercel.json routes rather than the
# filesystem, so renaming a rewrite can strip a lesson off the front page without
# touching anything under demos/.
if git diff --cached --name-only | grep -qE '^(demos/(.*\.html|lib/(molecules|skel|mol-[^/]+|lib-node)\.js)|index\.html|vercel\.json)$'; then
  if ! node tools/check-pages.js > /tmp/cp.$$ 2>&1; then
    tail -25 /tmp/cp.$$; rm -f /tmp/cp.$$
    echo ""
    echo "pre-commit FAILED: check-pages.js — a page names a molecule it does not load,"
    echo "  a proton hop leaves its source atom on the molecule, or the root index"
    echo "  links a URL that vercel.json no longer routes."
    exit 1
  fi
  rm -f /tmp/cp.$$
else
  echo "pre-commit: skipping check-pages.js — no page or registry file staged"
fi

# The mass-action model is demos/massaction/, so its own folder gates it — but
# glycolysis-lab.html is in the pattern too, because the SCENARIOS (each step's
# ΔE, and the names on the curve) live on the host page and the checker lifts
# them from there. `ea` is a legibility knob somebody will reach for, and it is
# now shared by two pages, which is the reason it became a module at all.
if git diff --cached --name-only | grep -qE '^demos/(massaction/.*|glycolysis-lab\.html)$'; then
  if ! node massaction/check-massaction.js > /tmp/cma.$$ 2>&1; then
    tail -25 /tmp/cma.$$; rm -f /tmp/cma.$$
    echo ""
    echo "pre-commit FAILED: check-massaction.js — the mass-action demo no longer"
    echo "  teaches what it claims. See the header for which claim broke."
    exit 1
  fi
  rm -f /tmp/cma.$$
else
  echo "pre-commit: skipping check-massaction.js — nothing under demos/massaction/ staged"
fi

# demos/coupling/ gates itself. The published ΔG°′ live on the HOST page, so
# the bench is in the pattern too — the checker lifts the numbers from it and
# audits them against the textbook values, which is the one error here that
# would otherwise be invisible: a module that adds correctly from a wrong
# −7.3 teaches a wrong answer confidently.
if git diff --cached --name-only | grep -qE '^demos/coupling/.*$'; then
  if ! node coupling/check-coupling.js > /tmp/ccp.$$ 2>&1; then
    tail -25 /tmp/ccp.$$; rm -f /tmp/ccp.$$
    echo ""
    echo "pre-commit FAILED: check-coupling.js — the coupling model no longer"
    echo "  teaches what it claims. A ΔG failure means a published number moved;"
    echo "  a drawing failure means the figure stopped being the sum."
    exit 1
  fi
  rm -f /tmp/ccp.$$
else
  echo "pre-commit: skipping check-coupling.js — nothing under demos/coupling/ staged"
fi

# demos/energy/ gates itself, PLUS both pathway pages — the SHAPE FLAGS live on
# the host's STEPS table (`up`, `shallow`, `pull`, `rev`), so the claim a figure
# makes is edited over there and drawn over here. A typo'd flag falls through to
# the plain shape, which is a real drop: the step then renders a confident claim
# nobody made, and nothing on screen looks wrong.
if git diff --cached --name-only \
   | grep -qE '^demos/(energy/.*|glycolysis-lab\.html|krebs-lab\.html|fermentation-lab\.html)$'; then
  if ! node energy/check-energy.js > /tmp/cen.$$ 2>&1; then
    tail -25 /tmp/cen.$$; rm -f /tmp/cen.$$
    echo ""
    echo "pre-commit FAILED: check-energy.js — the free-energy figures stopped saying"
    echo "  what they claim. A magnitude failure means the unscaled axis grew a number;"
    echo "  a tone failure means a coupled trace is stroked none and has vanished."
    exit 1
  fi
  rm -f /tmp/cen.$$
else
  echo "pre-commit: skipping check-energy.js — no energy/ or pathway page staged"
fi

# demos/reaction/ gates itself, PLUS every page that drives it. The checker's
# first claim is that no lesson names an `fx:` the verb table does not register,
# and that failure lives in the PAGE, not the module: a typo'd verb used to fall
# through the old chain's bare `else` and run as a silent 280 ms swap — the step
# completed, the ledger moved, and the animation the whole step was about simply
# did not happen. Nothing on screen says "that string was wrong", so a gate that
# only fired on demos/reaction/ would miss the case it exists for.
if git diff --cached --name-only \
   | grep -qE '^demos/(reaction/.*|glycolysis-lab\.html|krebs-lab\.html|fermentation-lab\.html)$'; then
  if ! node reaction/check-reaction.js > /tmp/crx.$$ 2>&1; then
    tail -25 /tmp/crx.$$; rm -f /tmp/crx.$$
    echo ""
    echo "pre-commit FAILED: check-reaction.js — a step names an animation that"
    echo "  does not exist, or a verb stopped being a per-lane body. The second"
    echo "  one is how the whole-step and per-lane routes drifted apart before."
    exit 1
  fi
  rm -f /tmp/crx.$$
else
  echo "pre-commit: skipping check-reaction.js — nothing under demos/reaction/ staged"
fi

# demos/membrane/ gates itself. check-pump.js audits pump.js, which is the CYCLE
# and deliberately holds no THREE — so the one claim the whole lesson rests on,
# that the pump is never open at both ends, is machine-checkable rather than
# checked by looking at a screenshot. It also counts the stoichiometry out of
# the animation rather than trusting the caption: 3 Na⁺ out and 2 K⁺ in is why
# the pump is electrogenic, and a page whose ledger disagrees with what moves
# on screen teaches the wrong number confidently.
#
# parts.js is NOT covered — it reaches for THREE at module scope and cannot be
# required here. That is a real gap, not an oversight: its profile maths would
# have to be split out to be checkable offline.
if git diff --cached --name-only | grep -qE '^demos/membrane/.*$'; then
  if ! node membrane/check-pump.js > /tmp/cpu.$$ 2>&1; then
    tail -25 /tmp/cpu.$$; rm -f /tmp/cpu.$$
    echo ""
    echo "pre-commit FAILED: check-pump.js — the pump stopped being a pump."
    echo "  A both-gates-open failure means the cycle now describes a leak;"
    echo "  a stoichiometry failure means the ledger and the animation disagree."
    exit 1
  fi
  rm -f /tmp/cpu.$$
else
  echo "pre-commit: skipping check-pump.js — nothing under demos/membrane/ staged"
fi

# demos/water/ gates itself. check-water.js audits thermo(), which is the
# temperature continuum and deliberately holds no THREE — so the numbers
# water-lab.html PRINTS ("freezes -13C, boils 104C") are computed against a
# checker rather than eyeballed on screen. The colligative shift is the one
# claim on that step a student cannot verify by looking: the ice looks like ice
# either way, and only the printed freezing point says the salt did anything.
#
# The rest of watersim.js is NOT covered — it reaches for THREE and runs a
# molecular-dynamics loop with no fixed point to assert. water/water-test.html
# is where those invariants (<=4 H-bonds per molecule, no merged oxygens) are
# checked, live and every frame, because their failure mode is a transient.
if git diff --cached --name-only | grep -qE '^demos/water/.*$'; then
  if ! node tools/check-water.js > /tmp/cwt.$$ 2>&1; then
    tail -25 /tmp/cwt.$$; rm -f /tmp/cwt.$$
    echo ""
    echo "pre-commit FAILED: check-water.js — water changed phase somewhere it should not."
    echo "  Every assertion there is a number the solvent step renders as text."
    exit 1
  fi
  rm -f /tmp/cwt.$$
else
  echo "pre-commit: skipping check-water.js — nothing under demos/water/ staged"
fi

# demos/diffusion/ gates itself, and palette.js is in the pattern from the other
# direction: radiusOf() sizes a molecule from PALETTE.radii, so retuning those
# for a 3D page — their actual job, with no idea this module exists — moves
# every diffusion rate on the page. That is the one failure here nothing else
# can see, and check-diffusion.js catches it by measuring the predictions
# against four published diffusion coefficients.
if git diff --cached --name-only | grep -qE '^demos/(diffusion/.*|lib/palette\.js)$'; then
  if ! node diffusion/check-diffusion.js > /tmp/cdf.$$ 2>&1; then
    tail -30 /tmp/cdf.$$; rm -f /tmp/cdf.$$
    echo ""
    echo "pre-commit FAILED: check-diffusion.js — the diffusion model no longer"
    echo "  teaches what it claims. A radiusOf failure means the molecule-size"
    echo "  proxy stopped tracking real diffusion coefficients; see the header."
    exit 1
  fi
  rm -f /tmp/cdf.$$
else
  echo "pre-commit: skipping check-diffusion.js — nothing under demos/diffusion/ staged"
fi

# demos/lobes/ gates itself, plus every mol-*.js and kit/molgraph.js. Wider than
# its own folder for the reason the others are: lobes.js derives EVERY direction
# and count from a spec's bond vectors and bond ORDERS through molgraph, so a
# geometry edit or a Kekulé re-tag somewhere else silently moves lone pairs on
# this module's molecules. Nothing about a lone pair pointing the wrong way
# looks wrong — that is the whole reason the checker exists — so the gate has to
# fire on the files that can move one, not on the ones that draw it.
if git diff --cached --name-only \
   | grep -qE '^demos/(lobes/.*|lib/(mol-[a-z]*|molecules|skel)\.js|kit/molgraph\.js)$'; then
  if ! node lobes/check-lobes.js > /tmp/clb.$$ 2>&1; then
    tail -30 /tmp/clb.$$; rm -f /tmp/clb.$$
    echo ""
    echo "pre-commit FAILED: check-lobes.js — the lone pairs no longer point"
    echo "  where the chemistry says. A conjugation failure means a nitrogen that"
    echo "  DONATES is being drawn as an acceptor; see the header."
    exit 1
  fi
  rm -f /tmp/clb.$$
else
  echo "pre-commit: skipping check-lobes.js — no spec, molgraph or lobes/ file staged"
fi

# dna/ gates itself, plus the nucleobase specs and the two modules its answers
# are built out of. pairing.js takes lone-pair directions from lobes/ and has
# kit/hbond.js count the bonds in the pose it solves, so a change in either can
# flip a verdict this checker is the only thing watching — and the page shows a
# wrong pairing as confidently as a right one.
if git diff --cached --name-only | grep -qE '^demos/(dna/.*|dna-lab\.html|lib/mol-nucleic\.js|lobes/.*|kit/hbond\.js)'; then
  if ! node dna/check-dna.js > /tmp/cdna.$$ 2>&1; then
    tail -25 /tmp/cdna.$$; rm -f /tmp/cdna.$$
    echo ""
    echo "pre-commit FAILED: check-dna.js — base pairing no longer holds."
    exit 1
  fi
  rm -f /tmp/cdna.$$
else
  echo "pre-commit: skipping check-dna.js — nothing under demos/dna/ staged"
fi

# kit/ gates itself, plus the domain files it is asserted against: check-kit.js
# runs molgraph over REAL specs (glucose's five hydroxyls, the phosphoryl group
# that leaves its bridging oxygen behind), so a spec edit can break it from
# outside the folder. Cheap — it is pure arithmetic over the registry.
#
# lobes/ is in the pattern for the same reason and one more: hbond.js takes its
# acceptor capacity FROM lobes.js, and check-kit.js asserts the consequence —
# that adenine's amino nitrogen donates and never accepts. Edit the conjugation
# rule in lobes/ and the assertion that catches A–T coming out backwards lives
# over here, so the two have to fire together.
if git diff --cached --name-only | grep -qE '^demos/(kit/.*|lobes/.*|lib/(molecules|skel|mol-[^/]+)\.js)$'; then
  if ! node kit/check-kit.js > /tmp/ck.$$ 2>&1; then
    tail -25 /tmp/ck.$$; rm -f /tmp/ck.$$
    echo ""
    echo "pre-commit FAILED: check-kit.js — the timeline or the spec queries under"
    echo "  demos/kit/ no longer do what the pages built on them assume."
    exit 1
  fi
  rm -f /tmp/ck.$$
else
  echo "pre-commit: skipping check-kit.js — nothing under demos/kit/ staged"
fi

# molecule-builder/ gates on itself AND on the two drag modules, because the
# assertion runs across the seam between them: the builder's frame widths are
# only right as long as no recipe deals an atom past them, and the starts live
# in covalent-drag.js / ionic-drag.js. Widen a scatter over there and the atom
# leaves the box over here, on the opening screen, in every embedded panel.
# palette.js is in too — the widths are measured off display radii, so a retune
# moves the answer without either module changing.
if git diff --cached --name-only | grep -qE '^demos/(molecule-builder/.*|lib/(covalent-drag|ionic-drag|palette)\.js)$'; then
  if ! node molecule-builder/check-molecule-builder.js > /tmp/cmb.$$ 2>&1; then
    tail -25 /tmp/cmb.$$; rm -f /tmp/cmb.$$
    echo ""
    echo "pre-commit FAILED: check-molecule-builder.js — a recipe routes to the"
    echo "  wrong mechanic, or deals an atom outside the frame the builder opens with."
    exit 1
  fi
  rm -f /tmp/cmb.$$
else
  echo "pre-commit: skipping check-molecule-builder.js — no builder or drag module staged"
fi

# Everything folding-lab is now under demos/folding/, so one pattern covers its
# modules, its data and its bake tools. palette.js is in too, from the other
# direction: folding-lab derives its display radii from PALETTE.radii / SCALE,
# so a palette retune can bury that page's bond sticks inside its atoms, and
# check-molecules cannot see it — the page has no spec in the registry.
#
# The three baked files are the reason this matters. A stale one is invisible
# from the page: it animates a perfectly plausible fold, or draws a filament
# from a screw the code no longer produces.
if git diff --cached --name-only | grep -qE '^demos/(folding/.*|lib/palette\.js)$'; then
  if ! node folding/tools/check-folding.js > /tmp/cf.$$ 2>&1; then
    tail -30 /tmp/cf.$$; rm -f /tmp/cf.$$
    echo ""
    echo "pre-commit FAILED: check-folding.js"
    echo "  If a baked file is stale, re-run the matching tool:"
    echo "    node folding/tools/bake-fold.js    (the trajectory)"
    echo "    node folding/tools/bake-villin.js  (the eight arrangements)"
    echo "    node folding/tools/bake-actin.js   (the filament + complex)"
    exit 1
  fi
  rm -f /tmp/cf.$$
else
  echo "pre-commit: skipping check-folding.js — nothing under demos/folding/ staged"
fi

# residues.js is generated from structures this repo commits, so it can go
# stale two ways: the baker changes, or a source structure does. Both patterns
# are here. It is cheap (instant) and it carries the L/D assertion, which is
# one of only two places in this repo that can catch a mirrored molecule.
if git diff --cached --name-only | grep -qE '^demos/(lib/residues\.js|tools/(bake|check)-residues\.js|hemoglobin/data/2HHB\.pdb|folding/data/9ZZI\.pdb)$'; then
  if ! node tools/check-residues.js > /tmp/cr.$$ 2>&1; then
    tail -25 /tmp/cr.$$; rm -f /tmp/cr.$$
    echo ""
    echo "pre-commit FAILED: check-residues.js"
    echo "  If the table is stale:  node tools/bake-residues.js"
    echo "  A D-AMINO ACID failure is the one to take seriously — it means the"
    echo "  side chains are mirrored, and they render exactly the same."
    exit 1
  fi
  rm -f /tmp/cr.$$
else
  echo "pre-commit: skipping check-residues.js — no residue table or source staged"
fi

# The haemoglobin page's trajectory has TWO upstream dependencies outside its
# own folder, and both can make it stale without touching it: folding.js's
# solver produces the fold, and ribbon.js's dssp is cross-checked against
# 2HHB's HELIX records. check-folding.js does not look at this file, so
# without this block a solver change would be caught for villin and silently
# ignored for haemoglobin — the exact asymmetry that makes a stale bake hard
# to notice, since the page still animates a perfectly plausible fold.
#
# TWO MODES, because the full check re-runs the unfold and that is 56 of its
# 57 seconds. A stale trajectory can only be PRODUCED by a change to the code
# that produces it, so only those files pay for it:
#
#   full    bake-unfold.js, bake-hb.js (the encoder), folding/folding.js,
#           folding/ribbon.js  — re-bakes and compares the bytes
#   quick   the page, the captions, bake-quaternary.js, check-hb.js itself
#           — 56 of the 59 assertions, off the committed file, in 0.3 s
#
# Editing a caption cannot make 2HHB-B.fold.bin disagree with its source, and
# spending a minute to prove it did not is how a hook teaches people to reach
# for --no-verify.
# hemoglobin-lab.html is in the gate because check-hb.js asserts numbers the
# PAGE says out loud — "eight hydrogen bonds", 72 vs 43 contacts, 103, 146.
# The page is the likeliest file to change one of those, and it lives outside
# hemoglobin/, so leaving it out made the checker blind to the edit it most
# needs to see. Quick mode: a caption cannot make a bake stale.
if git diff --cached --name-only | grep -qE '^demos/(hemoglobin/.*|hemoglobin-lab\.html|folding/folding\.js|folding/ribbon\.js)$'; then
  if git diff --cached --name-only | grep -qE '^demos/(hemoglobin/tools/bake-unfold\.js|hemoglobin/tools/bake-hb\.js|folding/folding\.js|folding/ribbon\.js)$'; then
    HBMODE=""
    echo "pre-commit: check-hb.js — full run, a bake input changed (~57 s) ..."
  else
    HBMODE="--quick"
  fi
  if ! node hemoglobin/tools/check-hb.js $HBMODE > /tmp/ch.$$ 2>&1; then
    tail -30 /tmp/ch.$$; rm -f /tmp/ch.$$
    echo ""
    echo "pre-commit FAILED: check-hb.js"
    echo "  If a baked file is stale, re-run the matching tool:"
    echo "    node hemoglobin/tools/bake-unfold.js      (the fold trajectory, ~60 s)"
    echo "    node hemoglobin/tools/bake-quaternary.js  (level 4's other chains)"
    echo "  NOT bake-hb.js — it is superseded and refuses to run."
    exit 1
  fi
  rm -f /tmp/ch.$$
else
  echo "pre-commit: skipping check-hb.js — nothing under demos/hemoglobin/ staged"
fi

# api/ and demos/ask/ gate themselves, PLUS every lesson page, because that is
# where the claims break. A target asserts that #trange exists on water-lab and
# that a step is still called "Why Ice Floats" — rename a heading or drop a
# control id and the tutor points confidently at nothing. Any demos/*.html
# rather than the five lessons by name: the list would go stale the first time a
# lesson is added, and the checker is instant and offline.
#
# It also audits the cacheable half of the prompt against the active model's
# cache floor. That failure has NO other symptom: the answers, the aiming and
# the citations are all identical, and only the bill moves. See _tutor.js.
if git diff --cached --name-only | grep -qE '^(api/.*|demos/ask/.*|demos/[^/]*\.html)$'; then
  if ! node ask/check-ask.js > /tmp/cask.$$ 2>&1; then
    tail -30 /tmp/cask.$$; rm -f /tmp/cask.$$
    echo ""
    echo "pre-commit FAILED: check-ask.js — the tutor's targets no longer match the"
    echo "  pages, or the cacheable prompt fell under the model's cache floor."
    echo "  A target failure means the tutor points at something that moved;"
    echo "  a floor failure means every question now pays full rate, silently."
    exit 1
  fi
  rm -f /tmp/cask.$$
else
  echo "pre-commit: skipping check-ask.js — nothing under api/, demos/ask/ or a page staged"
fi

echo "pre-commit: molecules and pages check out."
