{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/ask.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/(.*).pdb",                   "destination": "/",            "permanent": false },
    { "source": "/viewer-compare",             "destination": "/",            "permanent": false },
    { "source": "/viewer-compare/(.*)",        "destination": "/",            "permanent": false },
    { "source": "/demos/water-lab.html",       "destination": "/water",       "permanent": true },
    { "source": "/demos/molecule-builder.html","destination": "/molecular-bonds", "permanent": true },
    { "source": "/demos/hemoglobin-lab.html",  "destination": "/protein",     "permanent": true },
    { "source": "/demos/glycolysis-lab.html",  "destination": "/glycolysis",  "permanent": true },
    { "source": "/demos/membrane-lab.html",    "destination": "/membrane",    "permanent": true },
    { "source": "/demos/nodegraph/nodegraph.html", "destination": "/nodes",  "permanent": true },

    { "source": "/demos/proteins/index.html",  "destination": "/proteins", "permanent": true },
    { "source": "/demos/proteins/reaction-map.html", "destination": "/proteins/reactions", "permanent": true },
    { "source": "/demos/proteins/atp-synthase/atp-synthase-test.html", "destination": "/proteins/atp-synthase", "permanent": true },
    { "source": "/demos/proteins/chymotrypsin/chymotrypsin-test.html", "destination": "/proteins/chymotrypsin", "permanent": true },
    { "source": "/demos/proteins/collagen/collagen-test.html", "destination": "/proteins/collagen", "permanent": true },
    { "source": "/demos/proteins/dna/dna-test.html", "destination": "/proteins/dna", "permanent": true },
    { "source": "/demos/proteins/ferritin/ferritin-test.html", "destination": "/proteins/ferritin", "permanent": true },
    { "source": "/demos/proteins/gfp/gfp-test.html", "destination": "/proteins/gfp", "permanent": true },
    { "source": "/demos/proteins/hexokinase/hexokinase-test.html", "destination": "/proteins/hexokinase", "permanent": true },
    { "source": "/demos/proteins/insulin/insulin-test.html", "destination": "/proteins/insulin", "permanent": true },
    { "source": "/demos/proteins/myoglobin/myoglobin-test.html", "destination": "/proteins/myoglobin", "permanent": true },
    { "source": "/demos/proteins/napump/napump-test.html", "destination": "/proteins/napump", "permanent": true },
    { "source": "/demos/proteins/prion/prion-test.html", "destination": "/proteins/prion", "permanent": true },
    { "source": "/demos/proteins/rnase/rnase-test.html", "destination": "/proteins/rnase", "permanent": true },
    { "source": "/demos/proteins/rubisco/rubisco-test.html", "destination": "/proteins/rubisco", "permanent": true },
    { "source": "/demos/proteins/trna/trna-test.html", "destination": "/proteins/trna", "permanent": true },
    { "source": "/demos/proteins/zif268/zif268-test.html", "destination": "/proteins/zif268", "permanent": true },


    { "source": "/builder",                    "destination": "/molecular-bonds", "permanent": false },
    { "source": "/hemoglobin",                 "destination": "/protein",         "permanent": false }
  ],
  "rewrites": [
    { "source": "/water",      "destination": "/demos/water-lab.html" },
    { "source": "/molecular-bonds", "destination": "/demos/molecule-builder.html" },
    { "source": "/protein",    "destination": "/demos/hemoglobin-lab.html" },
    { "source": "/glycolysis", "destination": "/demos/glycolysis-lab.html" },
    { "source": "/membrane",   "destination": "/demos/membrane-lab.html" },
    { "source": "/nodes",      "destination": "/demos/nodegraph/nodegraph.html" },

    { "source": "/proteins",   "destination": "/demos/proteins/index.html" },
    { "source": "/proteins/reactions", "destination": "/demos/proteins/reaction-map.html" },
    { "source": "/proteins/atp-synthase", "destination": "/demos/proteins/atp-synthase/atp-synthase-test.html" },
    { "source": "/proteins/chymotrypsin", "destination": "/demos/proteins/chymotrypsin/chymotrypsin-test.html" },
    { "source": "/proteins/collagen", "destination": "/demos/proteins/collagen/collagen-test.html" },
    { "source": "/proteins/dna", "destination": "/demos/proteins/dna/dna-test.html" },
    { "source": "/proteins/ferritin", "destination": "/demos/proteins/ferritin/ferritin-test.html" },
    { "source": "/proteins/gfp", "destination": "/demos/proteins/gfp/gfp-test.html" },
    { "source": "/proteins/hexokinase", "destination": "/demos/proteins/hexokinase/hexokinase-test.html" },
    { "source": "/proteins/insulin", "destination": "/demos/proteins/insulin/insulin-test.html" },
    { "source": "/proteins/myoglobin", "destination": "/demos/proteins/myoglobin/myoglobin-test.html" },
    { "source": "/proteins/napump", "destination": "/demos/proteins/napump/napump-test.html" },
    { "source": "/proteins/prion", "destination": "/demos/proteins/prion/prion-test.html" },
    { "source": "/proteins/rnase", "destination": "/demos/proteins/rnase/rnase-test.html" },
    { "source": "/proteins/rubisco", "destination": "/demos/proteins/rubisco/rubisco-test.html" },
    { "source": "/proteins/trna", "destination": "/demos/proteins/trna/trna-test.html" },
    { "source": "/proteins/zif268", "destination": "/demos/proteins/zif268/zif268-test.html" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
