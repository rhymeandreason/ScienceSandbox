{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/ask.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/(.*).pdb",                   "destination": "/",            "permanent": false },
    { "source": "/viewer-compare",             "destination": "/",            "permanent": false },
    { "source": "/viewer-compare/(.*)",        "destination": "/",            "permanent": false },
    { "source": "/demos/water-lab.html",       "destination": "/water",       "permanent": true },
    { "source": "/demos/molecule-builder.html","destination": "/molecular-bonds", "permanent": true },
    { "source": "/demos/hemoglobin-lab.html",  "destination": "/protein",     "permanent": true },
    { "source": "/demos/glycolysis-lab.html",  "destination": "/glycolysis",  "permanent": true },
    { "source": "/demos/membrane-lab.html",    "destination": "/membrane",    "permanent": true },
    { "source": "/demos/nodegraph/nodegraph.html", "destination": "/nodes",  "permanent": true },

    { "source": "/builder",                    "destination": "/molecular-bonds", "permanent": false },
    { "source": "/hemoglobin",                 "destination": "/protein",         "permanent": false }
  ],
  "rewrites": [
    { "source": "/water",      "destination": "/demos/water-lab.html" },
    { "source": "/molecular-bonds", "destination": "/demos/molecule-builder.html" },
    { "source": "/protein",    "destination": "/demos/hemoglobin-lab.html" },
    { "source": "/glycolysis", "destination": "/demos/glycolysis-lab.html" },
    { "source": "/membrane",   "destination": "/demos/membrane-lab.html" },
    { "source": "/nodes",      "destination": "/demos/nodegraph/nodegraph.html" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
