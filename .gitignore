# 2.7 MB of 20 NMR models; only prep.js reads it, and it bakes 169 KB.
# prep.js skips the ensemble when it is absent and prints the curl.
demos/proteins/prion/data/1QLZ.pdb
# derived from it, and no page loads it today
demos/proteins/prion/data/prp-view-ensemble.pdb

# 4.4 MB of seven raw depositions; only prep.js reads them, and it bakes 45 KB.
# prep.js's header carries the curl loop that fetches them back.
demos/proteins/rnase/data/src/
demos/proteins/myoglobin/data/src/

# 2.9 MB of six raw collagen depositions; only prep.js reads them, and it
# bakes 113 KB. prep.js's header carries the curl loop that fetches them back.
demos/proteins/collagen/data/src/

# 21 MB of six raw depositions (three of them mmCIF, which is the only format
# the human structures are published in); only prep.js reads them, and it bakes
# ~600 KB. prep.js's header carries the curl loop that fetches them back.
demos/proteins/atp-synthase/data/src/

# NOT gitignored: demos/proteins/napump/data/src/ — 4 MB of PDBs whose OPM
# copies are a second source that a plain RCSB curl does not reproduce. The
# orientation is the half of that bake nothing here could re-derive.
