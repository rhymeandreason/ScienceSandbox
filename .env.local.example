# Copy to .env.local (gitignored) and fill in the key for whichever provider you use.
# On Vercel these are project environment variables with the same names.

# Which model answers: gemini | anthropic
AI_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where the tutor writes its log: a Neon Postgres connection string, pooled
# (the -pooler host). Unset means logging is simply off, which is what a
# checkout without a database gets. Apply the schema with:
#   node demos/tools/db.js init
DATABASE_URL=

# Who may read /api/log and the viewer at demos/ask/log.html. UNSET means the
# endpoint answers only to requests from the machine it runs on, so it is off
# by default anywhere it is deployed. Set it, then open the page with ?key=.
LOG_TOKEN=

# Mark this deployment a test bench: a request may then pick its provider and
# supply its own system prompt. Leave it unset in production, or a visitor picks
# which key you spend and what the tutor is.
ASK_BENCH=1

# Optional model overrides. Defaults: gemini-3.7-flash, claude-opus-5
# Uncomment the line, not just the value. Rates for each model are in
# api/_providers/; a model with no rate there is reported as unpriced, not free.
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-sonnet-5
