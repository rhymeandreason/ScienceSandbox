# Copy to .env.local (gitignored) and fill in the key for whichever provider you use.
# On Vercel these are project environment variables with the same names.

# Which model answers: gemini | anthropic
AI_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where the tutor writes its log: a Neon Postgres connection string, pooled
# (the -pooler host). Unset means logging is simply off, which is what a
# checkout without a database gets. Apply the schema with:
#   node demos/tools/db.js init
DATABASE_URL=

# Optional model overrides. Defaults: gemini-3.7-flash, claude-opus-5
# Uncomment the line, not just the value. Rates for each model are in
# api/_providers/; a model with no rate there is reported as unpriced, not free.
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-sonnet-5

# Who may use the live tutor: cohort:secret pairs, comma separated.
#   TUTOR_KEYS=bio101-fall:<secret>,openday:<secret>
# A key names a CLASS, not a person, so the label is what the log records and
# what a rate limit attaches to; a link that escapes is revoked on its own.
# Students arrive at ...?k=<secret>, which the page stores and strips.
#
# UNSET MEANS NO GATE, which is what you want locally: the tutor answers with
# no link. Set it here to exercise the gate, and note it applies to localhost
# too - you will need ?k= like anyone else.
#
# Deployed, leaving this unset makes the tutor public and unmetered.
# TUTOR_KEYS=
